{
  "name": "bridgesync-constellation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @bridgesync/web",
    "dev:api": "npm run dev --workspace @bridgesync/api",
